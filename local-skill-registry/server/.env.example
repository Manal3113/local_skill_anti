PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_panchayat_key_2026_local_skill_registry

# --- Local MongoDB Engine (Ready out-of-the-box) ---
MONGODB_URI=mongodb://127.0.0.1:27017/local_skill_registry

# --- Supabase Cloud Alternative (Optional) ---
# Set to 'true' only after running server/supabase-schema.sql in Supabase SQL editor:
USE_SUPABASE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
